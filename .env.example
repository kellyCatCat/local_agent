# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会提交到仓库。

# OpenAI 兼容接口地址（以 /v1 结尾），例如 http://localhost:<端口>/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
# 单次请求超时（秒）
LLM_TIMEOUT=600
# 单次生成最大 token（留空则不传，由服务端决定）
LLM_MAX_TOKENS=

# 本地 skill 库目录：每个 skill 一个子目录，主文件为 SKILL.md
SKILLS_DIR=./skills
# skill 模板规范
TEMPLATE_PATH=./templates/skill_template.md
# 本地标准补充（本地标准 skill 的实际写法，与模板冲突时以它为准）
CONVENTIONS_PATH=./templates/skill_conventions.md
# 会话与写回备份存放目录
DATA_DIR=./data

# 127.0.0.1 仅本机访问；0.0.0.0 允许局域网内其他机器访问（启动时会打印局域网地址）
HOST=127.0.0.1
PORT=8000
